{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "assignees": ["sashatemereva13"],

  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],

  "labels": ["dependencies"],

  "separateMajorMinor": true,

  "prConcurrentLimit": 5,

  "prHourlyLimit": 0,

  "rangeStrategy": "bump",

  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dependencies"],

      "groupName": "production dependencies (minor + patch)",
      "groupSlug": "prod-minor-patch"
    },

    {
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["dependencies"],
      "labels": ["dependencies", "major-update"],
      "addLabels": ["needs-review"],
      "prPriority": 5
    },

    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (minor + patch)",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },

    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },

    {
      "description": "Third-party actions that receive deploy secrets (SSH key, registry token) are never merged without a human reading the diff.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["appleboy/ssh-action", "appleboy/scp-action", "burnett01/rsync-deployments", "docker/login-action", "docker/build-push-action", "renovatebot/github-action", "hashicorp/setup-terraform"],
      "groupName": "Deploy actions (secrets)",
      "automerge": false,
      "addLabels": ["needs-review"]
    }
  ],

  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",

  "dependencyDashboard": true,

  "prCreation": "immediate",
  "dependencyDashboardTitle": "renovate dependency dashboard"
}
