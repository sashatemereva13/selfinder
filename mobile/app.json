{
  "expo": {
    "name": "Selfinder",
    "slug": "selfinder-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.selfinder.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06060d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.selfinder.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "selfinder",
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Panchang-Light.ttf",
            "./assets/fonts/Panchang-Medium.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c39fff"
        }
      ],
      "expo-splash-screen",
      "expo-audio"
    ]
  }
}
